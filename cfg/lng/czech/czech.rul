subst	disertace.dic	text	; vìty pro disertaci

# pøidat èárku pøed "a":
with  "a"  word
{
	regress a>\X(!_!)
}
raise	\X:!		word	phone
syll	\X<\ _		colon   word
regress \X>\ (!_!)	colon	word
regress \X>a(!_!)

#
#  Následující odstavec ještì pøed transkripcí oznaèuje
#  koncová monosylaba, která podléhají pozdìjšímu
#  slévání do taktù. Po transkripci už nelze rozlišit
#  "mì" vs. "mnì".
#

with "mi mì se si ho mu ti tì"
{
	regress  _\ \n>~(!_!)   word  word
}

#
#  Zde se provádìjí transkripèní pravidla ze souboru
#  trans.rul
#

@include "trans.rul"

#
#  Následující pravidla ošetøují tøi teèky, støedník a pomlèku.
#

inside	\~	sent
{
   6x	regress  0>\#(!_0)	sent	; vložení pausy po tøech teèkách
}
regress  \~>.(!_!)	sent	sent
regress  \;>.(!_!)	sent	sent
regress  ->,(!_!)	sent	colon

if use_prosody
{
	if   lpcprosody
	{
		@include "lpcpros.rul"
		#@include "prosody.rul"
	}
	if   !lpcprosody
	{
		if   naive_prosody
		{
			@include "naive.rul"
		}
		if   !naive_prosody
		{
			@include "prosody.rul"
		}
	}
}

if	tsr_tool
{
#	debug tsrtool text
}

if    phr_break
{
	regress   0>\#(!_0)	colon	; vložení pausy
	inside	\#	phone
	{
		contour   t/-65   phone
		contour   i/-99   phone
	}
	5x  regress   0>\#(!_0)	sent	; vložení pausy
}

if   kadlec_dph
	segments  kadlec.dph    colon
if   !kadlec_dph
{
   if ptacek97_dph
	segments  ptacek97.dph  colon
   if !ptacek97_dph
   {
	if dubeda_dph
		segments  dubeda.dph	colon
	if !dubeda_dph
	{
		if betty_dph
		{
			@include "betty.rul"
			segments  betty.dph	colon
		}
		if !betty_dph
			segments  traditnl.dph  colon
  	}
   }
}

#
#  mírné vyhlazování se zejména snaží, aby hranièní difony
#  mezi slabikami získávaly prosodické hodnoty èásteènì
#  od obou slabik.  Pøedpokládá se, že difon pøechodu mezi
#  hláskami je pøipojen k hlásce prvé, proto se pøihlíží
#  pouze k pravému sousedu (váha 30%, vlastní hodnota
#  má tedy váhu 70%). Ideologicky èistá øešení jsou buïto
#  nevyhlazovat vùbec (pøiøadit difon doleva), nebo
#  vyhlazovat f/50\50, tj. kvalifikovat difon jako spojovací.
#

if	tsr_tool
{
#	debug tsrtool text
}

#smooth   f/70\30     word segment

if	tsr_tool
{
	debug tsrtool text
}
