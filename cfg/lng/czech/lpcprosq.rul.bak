inside	Q	colon
{
#	contour   f/-2	word  word
	<		colon  word
		[
			contour  f/+180	colon   word
		]
		[
			contour  f/+180:0	colon   word
		]
		[
			contour  f/+160:+180:-10	colon   word
		]
