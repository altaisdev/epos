$big	= ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÜ
$little = abcdefghijklmnopqrstuvwxyzäöü

# substitute these if they were in input, because they are used
# in the dictionary
regress \_>\ (!_!) word phone
regress \+>\ (!_!) word phone
regress \=>\ (!_!) word phone 
regress \'>\ (!_!) word phone
regress \%>\ (!_!) word phone

regress $big>$little(0_!) word phone

analyze	  hadi-bomp/morphemes.dic word phone

subst     hadi-bomp/bomp_epos.dic  morpheme phone

# split word into syllables
syll 0<\+	word phone
regress	\+>0(!_!) word phone

# raise F0 on main stress syllable
near \' syll phone
{
	contour	f/+10*	syll phone
}
regress \'>0(!_!) word phone


# raise F0 on second stress syllable
near \= syll phone
{
	contour	f/+5*	syll phone
}
regress \=>0(!_!) word phone 


if joerg_dph
{
        subst "P,pf T,ts X,tS"
	segments  joerg.dph		colon
}

if diane_dph
{
        subst "P,pf T,ts X,tS"
	segments  diane.dph		colon
}

